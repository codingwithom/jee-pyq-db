G\" overflow=\"overflow\"><svg style=\"vertical-align: -0.871ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"36.332ex\" height=\"3.199ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1029 16058.6 1414.1\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\"><use data-c=\"1D44E\" xlink:href=\"#MJX-TEX-I-1D44E\"></use></g><g data-mml-node=\"mo\" transform=\"translate(36.5,31)\"><use data-c=\"20D7\" xlink:href=\"#MJX-TEX-N-20D7\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(814.3,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(1870.1,0)\"><g data-mml-node=\"mrow\" transform=\"translate(220,394) scale(0.707)\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"1D451\" xlink:href=\"#MJX-TEX-I-1D451\"></use></g><g data-mml-node=\"mn\" transform=\"translate(606.2,363) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1009.7,0)\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\" transform=\"translate(24.5,0)\"><use data-c=\"1D45F\" xlink:href=\"#MJX-TEX-I-1D45F\"></use></g><g data-mml-node=\"mo\" transform=\"translate(21,31)\"><use data-c=\"20D7\" xlink:href=\"#MJX-TEX-N-20D7\"></use></g></g></g></g><g data-mml-node=\"mrow\" transform=\"translate(294.3,-377.4) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"1D451\" xlink:href=\"#MJX-TEX-I-1D451\"></use></g><g data-mml-node=\"msup\" transform=\"translate(523,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mn\" transform=\"translate(394,289) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g><rect width=\"1282.4\