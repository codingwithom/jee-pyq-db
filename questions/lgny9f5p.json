32\"></use></g></g></g></g></svg></mjx-container>. \n<br><br>\nUsing Newton's second law, the net force on the particle is given by:\n<br><br>\n<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.357ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"10.143ex\" height=\"2.807ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1083 4483.1 1240.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\"><use data-c=\"1D439\" xlink:href=\"#MJX-TEX-I-1D439\"></use></g><g data-mml-node=\"mo\" transform=\"translate(225,269)\"><use data-c=\"20D7\" xlink:href=\"#MJX-TEX-N-20D7\"></use></g></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(676,-150) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"1D45B\" xlink:href=\"#MJX-TEX-I-1D45B\"></use></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"1D452\" xlink:href=\"#MJX-TEX-I-1D452\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1066,0)\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(2012.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(3068.6,0)\"><use data-c=\"1D45A\" xlink:href=\"#MJX-TEX-I-1D45A\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3946.6,0)\"><g data-mml-node=\"mover\"><g data-mml-node=\"mi\"><use data-c=\"1D44E\" xlink:href=\"#MJX-TEX-I-1D44E\"></use></g><g data-mml-node=\"mo\" transform=\"translate(36.5,31)\"><use data-c=\"20D7\" xlink:href=\"#MJX-TEX-N-20D7\"></use></g></g></g></g></g></svg></mjx-container>\n<br><br>\nwhere <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow