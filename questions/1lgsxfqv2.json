ke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\" transform=\"translate(778,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1736.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2792.6,0)\"><g data-mml-node=\"msup\" transform=\"translate(220,394) scale(0.707)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4C\" xlink:href=\"#MJX-TEX-N-4C\"></use></g></g><g data-mml-node=\"mn\" transform=\"translate(658,363) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"mrow\" transform=\"translate(290.9,-345) scale(0.707)\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(500,0)\"><g data-mml-node=\"mi\"><use data-c=\"49\" xlink:href=\"#MJX-TEX-N-49\"></use></g></g></g><rect width=\"950.6\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></svg></mjx-container>\n<br><br>\nUsing this relation, we can find the ratio of the final kinetic energy (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.72ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.288ex\" height=\"2.265ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 3663.3 1001.2\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4B\" xlink:href=\"#MJX-TEX-N-4B\"></use><use data-c=\"45\" xlink:href=\"#MJX-TEX-N-45\" transf