eXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1186.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"42\" xlink:href=\"#MJX-TEX-N-42\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2772.3,0)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g><g data-mml-node=\"mn\" transform=\"translate(4050.1,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g><g data-mml-node=\"msup\" transform=\"translate(4550.1,0)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1383,477.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(6755.5,0)\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g><g data-mml-node=\"msup\" transform=\"translate(7755.7,0)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"42\" xlink:href=\"#MJX-TEX-N-42\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(741,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"mn\" transform=\"translate(778,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></g></svg></mjx-container>\n<p>\u091c\u092c \u0915\u093f\u0938\u0940 \u092f\u094c\u0917\u093f\u0915 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092a\u0930\u092e\u093e\u0923\u0941 \u0915\u0940 \u0938\u092c\u0938\u0947 \u0915\u092e \u0911\u0915\u094d\u0938\u0940\u0915\u0930\u0923 \u0938\u0902\u0916\u094d\u092f\u093e -2 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0924\u094b \u0907\u0938\u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0915\u093f \u092a\u0930\u092e\u093e\u0923\u0941 \u0928\u0947 \u0907\u0938 \u0911\u0915\u094d\u0938\u0940\u0915\u0930\u0923 \u0905\u0935\u0938\u094d\u0925\u093e \u0915\u094b \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0909\u0926\u093e\u0938\u0940\u0928 \u0905\u0935\u0938\u094d\u0925\u093e \u0938\u0947 \u092a\u0930\u0947 \u0926\u094b \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u0939\u0948\u0902\u0964 \u0910\u0938\u093e \u0907\u0938\u0932\u093f\u090f \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u094b\u0902 \u0915\u093e \u0932\u093e\u092d \u0911\u0915\u094d\u0938\u0940\u0915\u0930\u0923 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u094b \u0905\u0927\u093f\u0915 \u090b\u0923\u093e\u0924\u094d\u092e\u0915 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0909\u0926\u093e\u0938\u0940\u0928 \u092a\u0930\u092e\u093e\u0923\u0941 \u092e\u0947\u0902, \u092c\u093e\u0939\u0930\u0940 \u0915\u094b\u0936 \u092e\u0947\u0902 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u094b\u0902 \u0915\u094b \u0938\u0902\u092f\u094b\u091c\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u0905\u092d\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0914\u0930 \u092c\u0902\u0927\u0928 \u092e\u0947\u0902 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092d\u0942\u092e\u093f\u0915\u093e \u0928\u093f\u092d\u093e\u0924\u0947 \u0939\u0948\u0902\u0964</p><p>\u0926\u093f\u090f \u0917\u090f \u092f\u094c\u0917\u093f\u0915 <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.286ex\" height=\"1.959ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 1894.6 866\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"41\" xlink:href=\"#MJX-TEX-N-41\"></use></g></g><g data-mml-node=\"mn\" transform=\"translate(783,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1186.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"42\" xlink:href=\"#MJX-TEX-N-42\"></use></g></g></g></g></svg></mjx-container> \u092e\u0947\u0902, \u092a\u0930\u092e\u093e\u0923\u0941 B \u0915\u0940 \u0911\u0915\u094d\u0938\u0940\u0915\u0930\u0923 \u0905\u0935\u0938\u094d\u0925\u093e -2 \u0939\u0948, \u091c\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0907\u0938\u0928\u0947 \u0926\u094b \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u0939\u0948\u0902\u0964 \u0915\u093f\u0938\u0940 \u092a\u0930\u092e\u093e\u0923\u0941 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0905\u0937\u094d\u091f\u0915 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u094b \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0924\u093e\u0924\u094d\u092a\u0930\u094d\u092f \u0939\u0948 \u0915\u093f \u0907\u0938\u0915\u0940 \u0909\u0926\u093e\u0938\u0940\u0928 \u0905\u0935\u0938\u094d\u0925\u093e \u092e\u0947\u0902 \u091b\u0939 \u0938\u0902\u092f\u094b\u091c\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0925\u0947\u0964 \u0907\u0938\u0932\u093f\u090f, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u092a\u0930\u092e\u093e\u0923\u0941 B \u0915\u0947 \u0938\u0902\u092f\u094b\u091c\u0940 \u0915\u094b\u0936 \u092e\u0947\u0902 \u0936\u0941\u0930\u0941\u0906\u0924 \u092e\u0947\u0902 \u091b\u0939 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0930\u0939\u0947 \u0939\u094b\u0902\u0917\u0947\u0964 \u091c\u0948\u0938\u0947 \u0939\u0940 \u092f\u0939 \u0926\u094b \u0914\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u092f\u0939 -2 \u0915\u0940 \u0911\u0915\u094d\u0938\u0940\u0915\u0930\u0923 \u0938\u0902\u0916\u094d\u092f\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0915\u093f \u0905\u092c \u0907\u0938\u0915\u0947 \u0938\u0902\u092f\u094b\u091c\u0940 \u0915\u094b\u0936 \u092e\u0947\u0902 \u090f\u0915 \u092a\u0942\u0930\u094d\u0923 \u0905\u0937\u094d\u091f\u0915 \u092f\u093e \u0906\u0920 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0915\u0940 \u0909\u0926\u093e\u0938\u0940\u0928 \u0905\u0935\u0938\u094d\u0925\u093e \u092e\u0947\u0902 \u0938\u0902\u092f\u094b\u091c\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u094b\u0902 \u0915\u0940 \u092e\u0942\u0932 \u0938\u0902\u0916\u094d\u092f\u093e \u091b\u0939 \u0925\u0940\u0964</p>"}},"subject":"chemistry","timeAllotted":1