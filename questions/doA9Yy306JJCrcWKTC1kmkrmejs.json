ate(806.7,363) scale(0.707)\"><use data-c=\"2032\" xlink:href=\"#MJX-TEX-V-2032\"></use></g></g></g><g data-mml-node=\"mn\" transform=\"translate(1084.1,486) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"msup\" transform=\"translate(318.1,-377.4) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mn\" transform=\"translate(806.7,289) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><rect width=\"1251.9\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(1769.7,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2825.5,0)\"><g data-mml-node=\"mrow\" transform=\"translate(220,516.8) scale(0.707)\"><g data-mml-node=\"mo\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"mn\" transform=\"translate(389,0)\"><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\"></use></g><g data-mml-node=\"mi\" transform=\"translate(889,0)\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><g data-mml-node=\"msup\" transform=\"translate(1648,0)\"><g data-mml-node=\"mo\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-N-29\"></use></g><g data-mml-node=\"mn\" transform=\"translate(422,363) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g><g data-mml-node=\"msup\" transform=\"translate(671.8,-376.9) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><g data-mml-node=\"mn\" transform=\"translate(792,289) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g><rect width=\"1949.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g></g></g></svg></mjx-container></p>\n<p>This simplifies to:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.854ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"9.786ex\" height=\"3.276ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -1070.7 4325.5 1448\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mfrac\"><g data-mml-node=\"msup\" transform=\"translate(220,394) scale(0.707)\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mo\" transform=\"translate(806.7,363) scale(0.707)\"><use data-c=\"2032\" xlink:href=\"#MJX-TEX-V-2032\"></use></g></g></g><g data-mml-node=\"mn\" transform=\"translate(1084.1,486) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"msup\" transform=\"translate(318.1,-377.4) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mn\" transform=\"translate(806.7,289) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><rect width=\"1251.9\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(1769.7,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2825.5,0)\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\" transform=\"translate(1000,0)\"></use></g></g></g></svg></mjx-container></p>\n<p>Taking the square root of both sides, we get:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.239ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24.774ex\" height=\"2.398ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -954.5 10950.1 1060\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mi\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mo\" transform=\"translate(806.7,363) scale(0.707)\"><use data-c=\"2032\" xlink:href=\"#MJX-TEX-V-2032\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1328.9,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(2384.7,0)\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mo\" transform=\"translate(3323.9,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"msqrt\" transform=\"translate(4324.1,0)\"><g data-mml-node=\"mo\" transform=\"translate(0,94.5)\"><use data-c=\"221A\" xlink:href=\"#MJX-TEX-N-221A\"></use></g><g transform=\"translate(853,0)\"><g data-mml-node=\"mn\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\" transform=\"translate(1000,0)\"></use></g></g><rect width=\"1500\" height=\"60\" x=\"853\" y=\"834.5\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(6954.9,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(8010.7,0)\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g><g data-mml-node=\"mo\" transform=\"translate(8949.9,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"mn\" transform=\"translate(9950.1,0)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\" transform=\"translate(500,0)\"></use></g></g></g></svg></mjx-container></p>\n<p>So, the period of another satellite in a circular orbit of radius <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.848ex\" height=\"1.595ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1259 705\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\"></use></g><g data-mml-node=\"mi\" transform=\"translate(500,0)\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g></g></g></svg></mjx-container> is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"3.885ex\" height=\"1.581ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -677 1717 699\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1000,0)\"><use data-c=\"1D447\" xlink:href=\"#MJX-TEX-I-1D447\"></use></g></g></g></svg></mjx-container>.</p>\n","qKey":"doA9Yy306JJCrcWKTC1kmkrmejs","paperKey":"jee-main-2021-online-18th-march-morning-shift","exam":"jee-main"}]}