8\" xlink:href=\"#MJX-TEX-SO-28\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(458,0)\"><g data-mml-node=\"mn\" transform=\"translate(220,394) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"mn\" transform=\"translate(220,-345) scale(0.707)\"><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\"></use></g><rect width=\"553.6\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(1251.6,0) translate(0 -0.5)\"><use data-c=\"29\" xlink:href=\"#MJX-TEX-SO-29\"></use></g></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1742.6,592) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">th</text></g></g></g></g></g></svg></mjx-container> of its initial volume. The ratio of final pressure and initial pressure is:</p>\n<p>(<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.489ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.229ex\" height=\"1.486ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -441 543 657\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D6FE\" xlink:href=\"#MJX-TEX-I-1D6FE\"></use></g></g></g></svg></mjx-container> is the ratio of specific heats of the gas at constant pressure and at constant volume)</p>","options":[{"identifier":"A","content":"<p>16</p>"},{"identifier":"B","content":"<p>32</p>"},{"identifier":"C","content":"<p>28</p>"},{"identifier":"D","content":"<p>40</p>"}],"correct_options":["B"],"explanation":"<p>To find the ratio of final pressure (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.667ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.52ex\" height=\"2.213ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1113.9 978\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D443\" xlink:href=\"#MJX-TEX-I-1D443\"></use></g><g data-mml-node=\"mi\" transform=\"translate(675,-150) scale(0.707)\"><use data-c=\"1D453\" xlink:href=\"#MJX-TEX-I-1D453\"></use></g></g></g></g></svg></mjx-container>) to initial pressure (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.357ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.192ex\" height=\"1.902ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 969 840.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D443\" xlink:href=\"#MJX-TEX-I-1D443\"></use></g><g data-mml-node=\"mi\" transform=\"translate(675,-150) scale(0.707)\"><use data-c=\"1D456\" xlink:href=\"#MJX-TEX-I-1D456\"></use></g></g></g></g></svg></mjx-container>), we use the adiabatic condition:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.063ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"13.59ex\" height=\"2.914ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -818.2 6006.9 1288\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D443\" xlink:href=\"#MJX-TEX-I-1D443\"></use></g><g data-mml-node=\"mi\" transform=\"translate(675,-150) scale(0.707)\"><use data-c=\"1D456\" xlink:href=\"#MJX-TEX-I-1D456\"></use></g></g><g data-mml-nod