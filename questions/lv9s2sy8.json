"></use></g><g data-mml-node=\"mi\" transform=\"translate(3529.1,0)\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container></li>\n\n</ul>\n\n<p>Let <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.74ex\" height=\"1.595ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 769 705\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D449\" xlink:href=\"#MJX-TEX-I-1D449\"></use></g></g></g></svg></mjx-container> be the voltage across the resistors.</p>\n\n<p><b>Power Dissipated in Each Resistor</b></p>\n\n<p>For the <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.765ex\" height=\"1.643ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -704 1222 726\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"35\" xlink:href=\"#MJX-TEX-N-35\"></use></g><g data-mml-node=\"mi\" transform=\"translate(500,0)\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container> resistor:</p>\n\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.816ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.476ex\" height=\"3.041ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -983.7 3746.5 1344.2\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D443\" xlink:href=\"#MJX-TEX-I-1D443\"></use></g><