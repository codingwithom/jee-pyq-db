o\" transform=\"translate(20891.2,0)\"><use data-c=\"2F\" xlink:href=\"#MJX-TEX-N-2F\"></use></g><g data-mml-node=\"msup\" transform=\"translate(21391.2,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D45A\" xlink:href=\"#MJX-TEX-I-1D45A\"></use></g><g data-mml-node=\"mn\" transform=\"translate(911,363) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g></g></g></g></svg></mjx-container></p>\n","exam":"jee-main","questions":[{"question_id":"pan-aluminium-rod-with-youngs-modulus-y70-times-10-jee-main-physics-motion-xdnij0jatk4wsgtw","qKey":"pan-aluminium-rod-with-youngs-modulus-y70-times-10-jee-main-physics-motion-xdnij0jatk4wsgtw","permalink":"pan-aluminium-rod-with-youngs-modulus-y70-times-10-jee-main-physics-motion-xdnij0jatk4wsgtw","paperTitle":"JEE Main 2023 (Online) 8th April Morning Shift","year":2023,"subject":"physics","chapter":"properties-of-matter","type":"mcq","marks":4,"negMarks":1,"content":"<p>An aluminium rod with Young's modulus <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.566ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"21.508ex\" height=\"2.52ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -864 9506.7 1114\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D44C\" xlink:href=\"#MJX-TEX-I-1D44C\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1040.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2096.6,0)\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(3596.8,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g da