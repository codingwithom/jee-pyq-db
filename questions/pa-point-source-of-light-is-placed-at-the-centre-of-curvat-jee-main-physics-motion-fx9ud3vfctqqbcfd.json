itFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"63\" xlink:href=\"#MJX-TEX-N-63\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(444,0)\"></use></g></g></g></g></svg></mjx-container> and the inner surface is completely reflecting. The force on the hemisphere due to the light falling on it is ____________ <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.452ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"10.667ex\" height=\"2.407ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -864 4714.7 1064\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(778,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"msup\" transform=\"translate(1378,0)\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(1033,393.1) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"mn\" transform=\"translate(778,0)\"><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\"></use></g></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3364.7,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-