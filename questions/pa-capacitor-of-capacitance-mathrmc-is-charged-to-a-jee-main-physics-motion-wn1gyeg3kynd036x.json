=\"translate(2089.6,0)\"><g data-mml-node=\"mi\" transform=\"translate(220,394) scale(0.707)\"><use data-c=\"1D449\" xlink:href=\"#MJX-TEX-I-1D449\"></use></g><g data-mml-node=\"mi\" transform=\"translate(307,-345) scale(0.707)\"><use data-c=\"1D451\" xlink:href=\"#MJX-TEX-I-1D451\"></use></g><rect width=\"743.8\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3073.3,0)\"><g data-mml-node=\"mover\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"1D423\" xlink:href=\"#MJX-TEX-B-1D423\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(188.5,269) translate(-250 0)\"><use data-c=\"2C6\" xlink:href=\"#MJX-TEX-N-2C6\"></use></g></g></g></g></g></svg></mjx-container> where <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.183ex\" height=\"1.593ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -694 523 704\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D451\" xlink:href=\"#MJX-TEX-I-1D451\"></use></g></g></g></svg></mjx-container> is the separation between the plates. <br><br>The electric flux through a closed surface enclosing only the positive plate of the capacitor is given by <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.806ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15.219ex\" height=\"2.629ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -805.5 6727 1161.9\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"3A6\" xlink:href=\"#MJX-TEX-N-3A6\"></use></g><g data-mml-node=\"mi\" transform=\"translate(755,-150) scale(0.707)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1623,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"msub\" transform=\"translate(2678.8,0)\"><g data-mml-node=\"mo\" transform=\"translate(0 0.5)\"><use data-c=\"222E\" xlink:href=\"#MJX-TEX-SO-222E\"></use></g><g data-mml-node=\"mi\" transform=\"translate(505,-340.9) scale(0.707)\"><use data-c=\"1D446\" xlink:href=\"#MJX-TEX-I-1D446\"></use></g></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3856.5,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D404\" xlink:href=\"#MJX-TEX-B-1D404\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(4834.8,0)\"><use data-c=\"22C5\" xlink:href=\"#MJX-TEX-N-22C5\"></use></g><g data-mml-node=\"mi\" transform=\"translate(5335,0)\"><use data-c=\"1D451\" xlink:href=\"#MJX-TEX-I-1D451\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(5858,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D400\" xlink:href=\"#MJX-TEX-B-1D400\"></use></g></g></g></g></svg></mjx-container>. <br><br>Since the electric field is perpendicular to the surface of the plate, the flux through the surface will be constant and given by <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"9.486ex\" height=\"1.959ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 4192.8 866\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"3A6\" xlink:href=\"#MJX-TEX-N-3A6\"></use></g><g data-mml-node=\"mi\" transform=\"translate(755,-150) scale(0.707)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1623,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mi\" transform=\"translate(2678.8,0)\"><use data-c=\"1D438\" xlink:href=\"#MJX-TEX-I-1D438\"></use></g><g data-mml-node=\"mi\" transform=\"translate(3442.8,0)\"><use data-c=\"1D434\" xlink:href=\"#MJX-TEX-I-1D434\"></use></g></g></g></svg></mjx-container>, where <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.697ex\" height=\"1.62ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -716 750 716\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D434\" xlink:href=\"#MJX-TEX-I-1D434\"></use></g></g></g></svg></mjx-container> is the area of the plate.</p>\n<p>The area of the positive plate is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.045ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.384ex\" height=\"3.251ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -975 3705.5 1437\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D434\" xlink:href=\"#MJX-TEX-I-1D434\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1027.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2083.6,0)\"><g data-mml-node=\"mi\" transform=\"translate(531.3,477.2) scale(0.707)\"><use data-c=\"1D444\" xlink:href=\"#MJX-TEX-I-1D444\"></use></g><g data-mml-node=\"mrow\" transform=\"translate(220,-345) scale(0.707)\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D700\" xlink:href=\"#MJX-TEX-I-1D700\"></use></g><g data-