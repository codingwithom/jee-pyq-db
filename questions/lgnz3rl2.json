ata-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(1000,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(1500,0)\"></use></g><g data-mml-node=\"mo\" transform=\"translate(7767.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(8823.6,0)\"><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\"></use><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(9823.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"56\" xlink:href=\"#MJX-TEX-N-56\" transform=\"translate(833,0)\"></use></g></g></g></g></svg></mjx-container>\n<br><br>\nSo the emf developed between the center and the ring is 88 mV.","qKey":"lgnz3rl2","paperKey":"jee-main-2023-online-15th-april-morning-shift","exam":"jee-main"}]}