)\"><g data-mml-node=\"mn\" transform=\"translate(396.8,394) scale(0.707)\"><use data-c=\"35\" xlink:href=\"#MJX-TEX-N-35\"></use></g><g data-mml-node=\"mn\" transform=\"translate(220,-345) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><rect width=\"907.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><rect width=\"1011.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(4535.6,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(5591.4,0)\"><g data-mml-node=\"mn\" transform=\"translate(220,394) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(396.8,-345) scale(0.707)\"><use data-c=\"33\" xlink:href=\"#MJX-TEX-N-33\"></use></g><rect width=\"907.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(6960.7,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(7960.9,0)\"><g data-mml-node=\"mn\" transform=\"translate(220,394) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mn\" transform=\"translate(396.8,-345) scale(0.707)\"><use data-c=\"35\" xlink:href=\"#MJX-TEX-N-35\"></use></g><rect width=\"907.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(9385.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(10441.6,0)\"><use data-c=\"38\" xlink:href=\"#MJX-TEX-N-38\"></use></g></g></g></svg></mjx-container></p>","qKey":"S0fuvXEuwhccTDHDQF1klf1q3si","paperKey":"jee-advanced-2016-paper-1-offline","exam":"jee-advanced","questions":[{"question_id":"S0fuvXEuwhccTDHDQF1klf1q3si","paperTitle":"JEE Advanced 2016 Paper 1 Offline","year":2016,"subject":"physics","chapter":"electromagnetic-induction","chapterGroup":"electricity","type":"integer","marks":3,"negMarks":0,"content":"Two inductors L<sub>1</sub> (inductance 1mH, internal resistance 3<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.633ex\" height=\"1.593ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -704 722 704\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container>) and L<sub>2</sub> (inductance 2 mH, internal resistance 4<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.633ex\" height=\"1.593ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -704 722 704\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container>), and a resistor R (resistance 12<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: 0;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.633ex\" height=\"1.593ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -704 722 704\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container>) are all connected in parallel across a 5V battery. The circuit is switched on at time t = 0. The ratio of the maximum to the minimum current (I<sub>max</sub> / I<sub>min</sub>) drawn from the battery is","options":[],"correct_options":[],"explanation":"<p>The circuit is shown in the figure</p>\n\n<br><br><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"JEE Advanced 2016 Paper 1 Offline Physics - Electromagnetic Induction Question 20 English Explanation 1\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1li36fljq/14d4415b-2479-42d3-9a1a-4d88ce24fead/0548a760-fb01-11ed-8333-f921c26ec676/file-1li36fljr.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">\n\n<p>Initially, right after the circuit is switched on (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.9ex\" height=\"1.804ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -775.2 3049.7 797.2\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mo\" transform=\"translate(638.8,0)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g><g data-mml-node=\"msup\" transform=\"translate(1916.6,0)\"><g data-mml-node=\"mn\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(533,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"2B\" xlink:href=\"#MJX-TEX-N-2B\"></use></g></g></g></g></g></svg></mjx-container>), the impedance (effective resistance) of inductors <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.528ex\" height=\"1.885ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1117.6 833\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D43F\" xlink:href=\"#MJX-TEX-I-1D43F\"></use></g><g data-mml-node=\"mn\" transform=\"translate(714,-150) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g></g></g></g></svg></mjx-container> and <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.339ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.528ex\" height=\"1.885ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -683 1117.6 833\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D43F\" xlink:href=\"#MJX-TEX-I-1D43F\"></use></g><g data-mml-node=\"mn\" transform=\"translate(714,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g></g></svg></mjx-container> is extremely high. Therefore, the inductors act as open circuits, and all the current flows through the resistor <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"8.63ex\" height=\"1.64ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -704 3814.6 725\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><g data-mml-node=\"mo\" transform=\"translate(1036.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2092.6,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mi\" transform=\"translate(3092.6,0)\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g></g></g></svg></mjx-container>. According to Kirchhoff's law, the current through the battery at this moment is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.814ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16.226ex\" height=\"2.798ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -877 7171.7 1236.8\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D456\" xlink:href=\"#MJX-TEX-I-1D456\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(378,-150) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mo\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"69\" xlink:href=\"#MJX-TEX-N-69\" transform=\"translate(833,0)\"></use><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\" transform=\"translate(1111,0)\"></use></g></g></g><g data-mml-node=\"mo\" transform=\"translate(1884.5,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(2940.3,0)\"><g data-mml-node=\"mi\" transform=\"translate(220,394) scale(0.707)\"><use data-c=\"1D449\" xlink:href=\"#MJX-TEX-I-1D449\"></use></g><g data-mml-node=\"mi\" transform=\"translate(223.5,-345) scale(0.707)\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><rect width=\"743.8\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mo\" transform=\"translate(4201.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(5257.6,0)\"><g data-mml-node=\"mn\" transform=\"translate(396.8,394) scale(0.707)\"><use data-c=\"35\" xlink:href=\"#MJX-TEX-N-35\"></use></g><g data-mml-node=\"mn\" transform=\"translate(220,-345) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><rect width=\"907.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"mspace\" transform=\"translate(6404.7,0)\"></g><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\" transform=\"translate(6571.7,0)\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">A</text></g></g></g></svg></mjx-container>.</p>\n\n<p>As the circuit reaches steady state (<mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.025ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"6.599ex\" height=\"1.441ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -626 2916.6 637\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mi\"><use data-c=\"1D461\" xlink:href=\"#MJX-TEX-I-1D461\"></use></g><g data-mml-node=\"mo\" transform=\"translate(638.8,0)\"><use data-c=\"2192\" xlink:href=\"#MJX-TEX-N-2192\"></use></g><g data-mml-node=\"mi\" transform=\"translate(1916.6,0)\"><use data-c=\"221E\" xlink:href=\"#MJX-TEX-N-221E\"></use></g></g></g></svg></mjx-container>), the impedance of the inductors drops to zero, and they function as resistors with their specified internal resistances.</p>\n\n<br><br><img src=\"https://app-content.cdn.examgoal.net/fly/1000/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png\" data-orsrc=\"https://app-content.cdn.examgoal.net/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png\" loading=\"lazy\" style=\"max-width:100%;height:auto;display:block;margin:0px auto;max-height:40vh\" alt=\"JEE Advanced 2016 Paper 1 Offline Physics - Electromagnetic Induction Question 20 English Explanation 2\" srcset=\"https://app-content.cdn.examgoal.net/fly/500/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 500w, https://app-content.cdn.examgoal.net/fly/750/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 750w, https://app-content.cdn.examgoal.net/fly/1000/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 1000w, https://app-content.cdn.examgoal.net/fly/1500/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 1500w, https://app-content.cdn.examgoal.net/fly/2000/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 2000w, https://app-content.cdn.examgoal.net/fly/2500/image/1li36i2z6/ccca250c-ff6f-43ba-8db7-29593a510370/4a5d9720-fb01-11ed-8333-f921c26ec676/file-1li36i2z7.png?format=png 2500w\" sizes=\"(max-width: 767px) 100vw, 720px\" decoding=\"async\">\n\n<br>The effective resistance of the circuit is <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.627ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"11.575ex\" height=\"2.385ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -777 5116.1 1054\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msub\"><g data-mml-node=\"mi\"><use data-c=\"1D445\" xlink:href=\"#MJX-TEX-I-1D445\"></use></g><g data-mml-node=\"mi\" transform=\"translate(792,-150) scale(0.707)\"><use data-c=\"1D452\" xlink:href=\"#MJX-TEX-I-1D452\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1449.3,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mo\" transform=\"translate(2505.1,0)\"><use data-c=\"28\" xlink:href=\"#MJX-TEX-N-28\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2894.1,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"mi\" transform=\"translate(3894.1,0)\"><use data-c=\"3A9\" xlink:href=\"#MJX-TEX-N-3A9\"></use></g><g data-mml-node=\"mo\" transform=\"translate(4616.1,0)\"><use data-c=\"2016\" xlink:href=\"#MJX-TEX-N-2016\"></use></g></g></g></svg></mjx-container> <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"over