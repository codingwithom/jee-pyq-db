n<p>\u0915\u0925\u0928 II : \u0917\u0941\u0932\u093e\u092c \u0915\u0940 \u092a\u0902\u0916\u0941\u0921\u093f\u092f\u094b\u0902 \u0938\u0947 \u0917\u0941\u0932\u093e\u092c \u0915\u0940 \u0938\u0941\u0917\u0928\u094d\u0927 \u0915\u0947 \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0935\u093e\u0937\u094d\u092a\u0936\u0940\u0932\u0924\u093e \u0924\u0925\u093e \u091c\u0932 \u092e\u0947\u0902 \u0905\u0927\u0941\u0932\u0928\u0936\u0940\u0932\u0924\u093e \u0915\u0947 \u0915\u093e\u0930\u0923 \u092d\u093e\u092a\u0940\u092f \u0906\u0938\u0935\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0943\u0925\u0915 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964</p>\n<p>\u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u0915\u0925\u0928\u094b\u0902 \u0915\u0947 \u0906\u0932\u094b\u0915 \u092e\u0947\u0902, \u0928\u0940\u091a\u0947 \u0926\u093f\u092f\u0947 \u0917\u092f\u0947 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0938\u0939\u0940 \u0909\u0924\u094d\u0924\u0930 \u091a\u0941\u0928\u093f\u092f\u0947 :</p>\n","options":[{"identifier":"A","content":"<p>\u0926\u094b\u0928\u094b\u0902 \u0915\u0925\u0928 I \u0914\u0930 \u0915\u0925\u0928 II \u0938\u0924\u094d\u092f \u0939\u0948\u0902\u0964</p>\n"},{"identifier":"B","content":"<p>\u0926\u094b\u0928\u094b\u0902 \u0915\u0925\u0928 I \u0914\u0930 \u0915\u0925\u0928 II \u0905\u0938\u0924\u094d\u092f \u0939\u0948\u0902\u0964</p>"},{"identifier":"C","content":"<p>\u0915\u0925\u0928 I \u0938\u0924\u094d\u092f \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0915\u0925\u0928 II \u0905\u0938\u0924\u094d\u092f \u0939\u0948\u0964</p>\n"},{"identifier":"D","content":"<p>\u0915\u0925\u0928 I \u0905\u0938\u0924\u094d\u092f \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0915\u0925\u0928 II \u0938\u0924\u094d\u092f \u0939\u0948\u0964</p>\n"}],"correct_options":["A"],"answer":null,"explanation":"<p>\u0936\u0930\u094d\u0915\u0930\u093e \u090f\u0932\u094d\u0915\u094b\u0939\u0949\u0932 \u092e\u0947\u0902 \u0918\u0941\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948, \u092a\u0930\u0902\u0924\u0941 NaCl (\u0938\u093e\u0927\u093e\u0930\u0923 \u0928\u092e\u0915) \u090f\u0932\u094d\u0915\u094b\u0939\u0949\u0932 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0918\u0941\u0932\u0924\u093e \u0939\u0948\u0964</p>\n<p>\u0905\u0924\u0903, \u090f\u0932\u094d\u0915\u094b\u0939\u0949\u0932 \u092e\u0947\u0902 \u0907\u0928\u0915\u0940 \u092d\u093f\u0928\u094d\u0928 \u0935\u093f\u0932\u0947\u092f\u0924\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \ufffd\ufffd\ufffd\u0930, \u0936\u0930\u094d\u0915\u0930\u093e \u0914\u0930 \u0928\u092e\u0915 \u0915\u0947 \u092e\u093f\u0936\u094d\u0930\u0923 \u0915\u094b \u0935\u093f\u0932\u093e\u092f\u0915 \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937\u0923 \u092f\u093e \u0935\u093f\u092d\u0947\u0926\u0940 \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937\u0923 \u0928\u093e\u092e\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u0943\u0925\u0915 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964</p>\n<p>\u0917\u0941\u0932\u093e\u092c \u0915\u093e \u0905\u0930\u094d\u0915 (\u0906\u0935\u0936\u094d\u092f\u0915 \u0924\u0947\u0932) \u092d\u093e\u092a \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0937\u094d\u092a\u0936\u0940\u0932 \u0939\u094b\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0915\u093f \u092f\u0939 \u092d\u093e\u092a \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0937\u094d\u092a\u0940\u0915\u0943\u0924 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0905\u0924\u0903, \u0907\u0938\u0947 \u092d\u093e\u092a \u0906\u0938\u0935\u0928 \u0935\u093f\u0927\u093f \u0926\u094d\u0935\u093e\u0930\u093e \u0917\u0941\u0932\u093e\u092c \u0915\u0940 \u092a\u0902\u0916\u0941\u0921\u093c\u093f\u092f\u094b\u0902 \u0938\u0947 \u092a\u0943\u0925\u0915 \u0915\u093f\u092f\u093e \