rrentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(500,0)\"><g data-mml-node=\"mi\"><use data-c=\"56\" xlink:href=\"#MJX-TEX-N-56\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(750,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1306,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2847.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mfrac\" transform=\"translate(3903.6,0)\"><g data-mml-node=\"mn\" transform=\"translate(396.8,394) scale(0.707)\"><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\"></use></g><g data-mml-node=\"mn\" transform=\"translate(220,-345) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><rect width=\"907.1\" height=\"60\" x=\"120\" y=\"220\"></rect></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(5050.7,0)\"><g data-mml-node=\"mi\"><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(917,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1473,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(7565.4,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(8621.2,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(9899.2,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p>So, the least count is;</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.452ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"34.142ex\" height=\"2.149ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -750 15090.6 950\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4C\" xlink:href=\"#MJX-TEX-N-4C\"></use><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\" transform=\"translate(625,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1624.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2680.6,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3180.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(5668.8,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"mn\" transform=\"translate(6669,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(7947,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(10490.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(11546.6,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(12824.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.242ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -525 1000 549\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mo\"><use data-c=\"21D2\" xlink:href=\"#MJX-TEX-N-21D2\"></use></g></g></g></svg></mjx-container> <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.452ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"25.369ex\" height=\"2.149ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -750 11213.1 950\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4C\" xlink:href=\"#MJX-TEX-N-4C\"></use><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\" transform=\"translate(625,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1624.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2680.6,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\" transform=\"translate(778,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3958.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(6502.3,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(7558.1,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(778,0)\"></use><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\" transform=\"translate(1278,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(9336.1,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"63\" xlink:href=\"#MJX-TEX-N-63\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(444,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p>Zero error occurs when the jaws of the calliper are completely closed but the zero mark of the main scale does not align with the zero mark of the Vernier scale.</p>\n<p>If the zero of the Vernier scale rests to the right of the main scale zero, the instrument will naturally measure a value larger than the true length and this is positive zero error.</p>\n<p>If the zero of the Vernier scale rests to the left of the main scale zero, it creates a negative zero error.</p>\n<p>It is given that the zero of the Vernier scale is shifted to the right. Therefore, the given Vernier scale is with a positive zero error.</p>\n<p>If Vernier division perfectly coincides with any main scale reading, then the zero error is,</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.048ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"11.093ex\" height=\"1.643ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 4903 726\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(721.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1777.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"6E\" xlink:href=\"#MJX-TEX-N-6E\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(2555.8,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3556,0)\"><g data-mml-node=\"mi\"><use data-c=\"4C\" xlink:href=\"#MJX-TEX-N-4C\"></use><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\" transform=\"translate(625,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p>Where n is the coinciding division. The problem states that the <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.199ex\" height=\"2.071ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -893.3 1855.8 915.3\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mn\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(533,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">th\u00a0</text></g></g></g></g></g></svg></mjx-container> division coincides.</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.452ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"27.474ex\" height=\"2.149ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -750 12143.6 950\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"65\" xlink:href=\"#MJX-TEX-N-65\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(721.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(1777.6,0)\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use></g><g data-mml-node=\"mo\" transform=\"translate(2499.8,0)\"><use data-c=\"D7\" xlink:href=\"#MJX-TEX-N-D7\"></use></g><g data-mml-node=\"mn\" transform=\"translate(3500,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(778,0)\"></use><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\" transform=\"translate(1278,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(5278,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"63\" xlink:href=\"#MJX-TEX-N-63\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(444,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(7432.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(8488.6,0)\"><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\"></use><use data-c=\"2E\" xlink:href=\"#MJX-TEX-N-2E\" transform=\"translate(500,0)\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(778,0)\"></use><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\" transform=\"translate(1278,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(10266.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"63\" xlink:href=\"#MJX-TEX-N-63\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(444,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p>Since the shift is to the right, the final error is +0.07 cm . </p>\n<p>Thus, the correct option is (C).</p>","qKey":"mnswhpuh","paperKey":"jee-main-2026-online-5th-april-morning-shift","exam":"jee-main","questions":[{"question_id":"mnswhpuh","paperTitle":"JEE Main 2026 (Online) 5th April Morning Shift","year":2026,"subject":"physics","chapter":"units-and-measurements","chapterGroup":"mechanics","type":"mcq","marks":4,"negMarks":1,"content":"<p>In a Vernier calipers, when both jaws touch each other, zero of the Vernier scale is shifted to the right of zero of the main scale and <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"4.199ex\" height=\"2.071ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -893.3 1855.8 915.3\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"msup\"><g data-mml-node=\"mn\"><use data-c=\"37\" xlink:href=\"#MJX-TEX-N-37\"></use></g><g data-mml-node=\"TeXAtom\" transform=\"translate(533,363) scale(0.707)\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">th\u00a0</text></g></g></g></g></g></svg></mjx-container> Vernier division coincides with a main scale reading. If the value of 1 main scale division is 1 mm and there are 10 Vernier scale divisions, then the Vernier caliper has</p>\n","options":[{"identifier":"A","content":"<p>0.07 cm negative zero error</p>\n"},{"identifier":"B","content":"<p>0.7 cm negative zero error</p>\n"},{"identifier":"C","content":"<p>0.07 cm positive zero error</p>\n"},{"identifier":"D","content":"<p>0.7 cm positive zero error</p>"}],"correct_options":["C"],"explanation":"<p>The Least Count is the smallest measurement that can be accurately taken using the instrument.</p>\n<p>For a Vernier calliper, the difference between the length of one Main Scale Division (MSD) and one Vernier Scale Division (VSD) is equal to the least count.</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.186ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20.837ex\" height=\"1.781ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 9210 787\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\"><g data-mml-node=\"mi\"><use data-c=\"4C\" xlink:href=\"#MJX-TEX-N-4C\"></use><use data-c=\"43\" xlink:href=\"#MJX-TEX-N-43\" transform=\"translate(625,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1624.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(2680.6,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(3180.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(917,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1473,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(5639.8,0)\"><use data-c=\"2212\" xlink:href=\"#MJX-TEX-N-2212\"></use></g><g data-mml-node=\"mn\" transform=\"translate(6640,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(7140,0)\"><g data-mml-node=\"mi\"><use data-c=\"56\" xlink:href=\"#MJX-TEX-N-56\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(750,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1306,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p>It is given that <mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.452ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15.467ex\" height=\"2.149ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -750 6836.6 950\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(500,0)\"><g data-mml-node=\"mi\"><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(917,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1473,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(3014.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(4070.6,0)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(4570.6,0)\"><g data-mml-node=\"mtext\" style=\"font-family: Roboto,'Tiro Devanagari Hindi','Tiro Bangla',sans-serif;\"><text data-variant=\"-explicitFont\" transform=\"scale(1,-1)\" font-size=\"884px\">\u00a0</text></g><g data-mml-node=\"mi\" transform=\"translate(600,0)\"><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\"></use><use data-c=\"6D\" xlink:href=\"#MJX-TEX-N-6D\" transform=\"translate(833,0)\"></use></g></g></g></g></svg></mjx-container>.</p>\n<p>In a standard Vernier calliper arrangement, 10 divisions on the Vernier scale correspond to the length of 9 divisions on the Main scale.</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.05ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16.155ex\" height=\"1.645ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -705 7140.6 727\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mn\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use><use data-c=\"30\" xlink:href=\"#MJX-TEX-N-30\" transform=\"translate(500,0)\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(1000,0)\"><g data-mml-node=\"mi\"><use data-c=\"56\" xlink:href=\"#MJX-TEX-N-56\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(750,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1306,0)\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(3347.8,0)\"><use data-c=\"3D\" xlink:href=\"#MJX-TEX-N-3D\"></use></g><g data-mml-node=\"mn\" transform=\"translate(4403.6,0)\"><use data-c=\"39\" xlink:href=\"#MJX-TEX-N-39\"></use></g><g data-mml-node=\"TeXAtom\" data-mjx-texclass=\"ORD\" transform=\"translate(4903.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"4D\" xlink:href=\"#MJX-TEX-N-4D\"></use><use data-c=\"53\" xlink:href=\"#MJX-TEX-N-53\" transform=\"translate(917,0)\"></use><use data-c=\"44\" xlink:href=\"#MJX-TEX-N-44\" transform=\"translate(1473,0)\"></use></g></g></g></g></svg></mjx-container></p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -0.054ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"2.262ex\" height=\"1.242ex\" role=\"img\" fo