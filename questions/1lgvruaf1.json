 data-mml-node=\"mn\" transform=\"translate(614,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g><g data-mml-node=\"mo\" transform=\"translate(1017.6,0)\"><use data-c=\"2F\" xlink:href=\"#MJX-TEX-N-2F\"></use></g><g data-mml-node=\"msub\" transform=\"translate(1517.6,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D44C\" xlink:href=\"#MJX-TEX-I-1D44C\"></use></g><g data-mml-node=\"mn\" transform=\"translate(614,-150) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g></g></g></g></svg></mjx-container> = 4)), substituting these values into the equation gives:</p>\n<p><mjx-container class=\"MathJax\" jax=\"SVG\" overflow=\"overflow\"><svg style=\"vertical-align: -1.023ex;\" xmlns=\"http://www.w3.org/2000/svg\" width=\"21.338ex\" height=\"3.178ex\" role=\"img\" focusable=\"false\" viewBox=\"0 -952.4 9431.2 1404.7\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"scale(1,-1)\"><g data-mml-node=\"math\"><g data-mml-node=\"mfrac\"><g data-mml-node=\"mrow\" transform=\"translate(220,446.1) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"394\" xlink:href=\"#MJX-TEX-N-394\"></use></g><g data-mml-node=\"msub\" transform=\"translate(833,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D43F\" xlink:href=\"#MJX-TEX-I-1D43F\"></use></g><g data-mml-node=\"mn\" transform=\"translate(714,-150) scale(0.707)\"><use data-c=\"31\" xlink:href=\"#MJX-TEX-N-31\"></use></g></g></g><g data-mml-node=\"mrow\" transform=\"translate(220,-346.3) scale(0.707)\"><g data-mml-node=\"mi\"><use data-c=\"394\" xlink:href=\"#MJX-TEX-N-394\"></use></g><g data-mml-node=\"msub\" transform=\"translate(833,0)\"><g data-mml-node=\"mi\"><use data-c=\"1D43F\" xlink:href=\"#MJX-TEX-I-1D43F\"></use></g><g data-mml-node=\"mn\" transform=\"translate(714,-150) scale(0.707)\"><use data-c=\"32\" xlink:href=\"#MJX-TEX-N-32\"></use></g></g></g><rect width=\"1579.2\" height=\"60\" x=\"120\" y=\"